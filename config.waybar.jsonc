{
  "custom/cpu": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-cpu",
    "interval": 0,
    "return-type": "json",
    "signal": 10
  },
  "custom/fan": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-fan",
    "interval": 0,
    "return-type": "json",
    "signal": 11
  },
  "custom/gpu": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-gpu",
    "interval": 0,
    "return-type": "json",
    "signal": 12
  },
  "custom/memory": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-memory",
    "interval": 0,
    "return-type": "json",
    "signal": 13
  },
  "custom/network": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-network",
    "interval": 0,
    "return-type": "json",
    "signal": 14
  },
  "custom/ping": {
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-ping",
    "interval": 0,
    "return-type": "json",
    "signal": 15
  },
  "custom/updates": {
    "escape": true,
    "exec": "{{EXECUTABLE_PATH}}/waybar-module-updates",
    "interval": 0,
    "return-type": "json",
    "signal": 16
  }
}