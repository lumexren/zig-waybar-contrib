{
  "custom/backlight": {
    "exec": "/usr/bin/waybar-module-backlight",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/battery": {
    "exec": "/usr/bin/waybar-module-battery",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/bluetooth": {
    "exec": "/usr/bin/waybar-module-bluetooth",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/cpu": {
    "exec": "/usr/bin/waybar-module-cpu",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/disk": {
    "exec": "/usr/bin/waybar-module-disk",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/fan": {
    "exec": "/usr/bin/waybar-module-fan",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/gpu": {
    "exec": "/usr/bin/waybar-module-gpu",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/memory": {
    "exec": "/usr/bin/waybar-module-memory",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/mpris": {
    "exec": "/usr/bin/waybar-module-mpris",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/network": {
    "exec": "/usr/bin/waybar-module-network",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/ping": {
    "exec": "/usr/bin/waybar-module-ping",
    "restart-interval": 10,
    "return-type": "json"
  },
  "custom/pipewire": {
    "exec": "/usr/bin/waybar-module-pipewire",
    "restart-interval": 10,
    "return-type": "json",
    "signal": 2,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "custom/updates": {
    "escape": true,
    "exec": "/usr/bin/waybar-module-updates",
    "restart-interval": 10,
    "return-type": "json",
    "signal": 1,
    "on-click": "pkill -SIGRTMIN+1 waybar-module-updates"
  }
}